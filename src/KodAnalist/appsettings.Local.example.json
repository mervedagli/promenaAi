{
  // Bu dosyayı "appsettings.Local.json" adıyla kopyalayıp kendi bilgisayarınıza göre doldurun.
  // appsettings.Local.json Git'e gönderilmez. API anahtarlarını buraya YAZMAYIN; user-secrets kullanın:
  //   dotnet user-secrets set "Foundry:ApiKey" "..."   ve   dotnet user-secrets set "Catalog:Key" "..."

  "Foundry": {
    // Foundry kaynak adı: https://<kaynak-adı>.services.ai.azure.com
    "ResourceName": "<foundry-kaynak-adi>",
    // Foundry'deki model dağıtımının adı
    "Deployment": "claude-sonnet-5"
  },
  "Catalog": {
    // Cosmos DB hesabının adresi. Boş bırakılırsa kural kataloğu kapalı çalışır.
    "Endpoint": "https://<cosmos-hesap-adi>.documents.azure.com:443/"
  },

  // Repolar varsayılan olarak kod-analist klasörünün yanında aranır (../../../promena_frontend vb.).
  // Farklı bir yerdeyse aynı sırayla tam yollarını yazın. Sıra appsettings.json ile aynı olmalı.
  "Repos": [
    { "Name": "promena_frontend", "Path": "C:/Projeler/promena_frontend" },
    { "Name": "ProSourceCore", "Path": "C:/Projeler/ProSourceCore" },
    { "Name": "Sourcing", "Path": "C:/Projeler/Sourcing" }
  ]
}
